# Copy to .env and fill in. Never commit .env.

# Postgres password for the compose database
POSTGRES_PASSWORD=change-me
# 32+ random characters; signs the session cookie (openssl rand -hex 32)
SESSION_SECRET=
# Port the web app is published on
WEB_PORT=3000
# true only when the site is served over HTTPS (behind a TLS proxy)
COOKIE_SECURE=false

# Tender reading by the model. Without a key the engine reads tenders with the rule-based reader.
ANTHROPIC_API_KEY=
# Optional: the model id (default claude-fable-5-1, the tender_engine extraction model)
EXTRACTION_MODEL=
# Optional: 1 makes a read fail instead of falling back to the rule-based reader
EXTRACTION_REQUIRE_LLM=

# Tender sets (RfS + amendments + clarifications). The compose file runs docling-serve and points
# the engine at it; set DOCLING_URL= (empty) to read the tables with PyMuPDF only.
# DOCLING_URL=http://docling:5001
# Optional: LlamaParse (LlamaIndex cloud) for scanned pages that have no text layer
LLAMA_CLOUD_API_KEY=

# The SECI RTC tab's voice bid agent (GPT-Live, gpt-live-1). Without a key the tab offers only the
# browser-voice guide. The key is used by the web server only; the browser never sees it.
# The microphone needs the app on HTTPS (or localhost).
OPENAI_API_KEY=
# Optional: the backend model that works the bid through the tools (default gpt-6-luna)
OPENAI_LIVE_BACKEND_MODEL=
# Optional: the voice (default marin)
OPENAI_LIVE_VOICE=

# Optional: the MCP server for Claude connectors (docs/MCP.md), at https://<site>/api/mcp/<MCP_TOKEN>.
# Off when empty. The token is the only key: at least 16 random characters, e.g. `openssl rand -hex 24`.
MCP_TOKEN=

# Local runs without compose (tools/dev.sh)
DATABASE_URL=postgres://tenderos:change-me@127.0.0.1:5432/tenderos
ENGINE_URL=http://127.0.0.1:8000

# Team sharing: email for assignments and answers (optional; without it people see their work in
# the Team panel). APP_URL puts a link to the bid in each mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM=
APP_URL=
